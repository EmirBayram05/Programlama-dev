<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-compilersource file="Resources/Styles/Styles.xaml" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Ortak Sabit Değerler -->
    <x:String x:Key="AppFontFamily">OpenSansRegular</x:String>
    <x:String x:Key="AppFontBold">OpenSansSemibold</x:String>

    <!-- Sayfa (ContentPage) Örtük Stili -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgColorLight}, Dark={StaticResource BgColorDark}}" />
    </Style>

    <!-- Shell Stili -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgColorLight}, Dark={StaticResource BgColorDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Shell.FlyoutBackground" Value="{AppThemeBinding Light={StaticResource BgColorLight}, Dark={StaticResource BgColorDark}}" />
    </Style>

    <!-- 1. BUTONLAR İÇİN ÖRTÜK (IMPLICIT) STİL (Hem temel stil hem x:Key ile referans verilebilir) -->
    <Style x:Key="BaseCalcButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OperatorBtnBgLight}, Dark={StaticResource OperatorBtnBgDark}}" />
    </Style>

    <!-- Tüm butonlara otomatik uygulanan implicit stil -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseCalcButtonStyle}" />

    <!-- 2. RAKAM BUTONLARI İÇİN AÇIK (EXPLICIT) STİL (BasedOn ile türetilmiş) -->
    <Style x:Key="NumberButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseCalcButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource NumberBtnBgLight}, Dark={StaticResource NumberBtnBgDark}}" />
    </Style>

    <!-- 3. İŞLEM BUTONLARI İÇİN AÇIK (EXPLICIT) STİL (BasedOn ile türetilmiş) -->
    <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseCalcButtonStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OperatorBtnBgLight}, Dark={StaticResource OperatorBtnBgDark}}" />
    </Style>

    <!-- 4. EŞİTTİR BUTONU İÇİN AÇIK (EXPLICIT) STİL (BasedOn ile türetilmiş) -->
    <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseCalcButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentColorLight}, Dark={StaticResource AccentColorDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Ekran ve Etiket (Label) Stilleri -->
    <Style x:Key="HistoryLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="End" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="Margin" Value="12,4" />
    </Style>

    <Style x:Key="DisplayLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource AppFontBold}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Margin" Value="12,0,12,8" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Ayarlar Sayfası Stilleri -->
    <Style x:Key="SettingsHeaderStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource AppFontBold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderColorLight}, Dark={StaticResource BorderColorDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
    </Style>

    <Style x:Key="SettingsRadioStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

</ResourceDictionary>