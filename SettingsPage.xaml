<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCalculator.SettingsPage"
             Title="Ayarlar">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="Görünüm (App Theme)"
               Style="{StaticResource SettingsHeaderStyle}" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <VerticalStackLayout Spacing="8" RadioButtonGroup.GroupName="ThemeGroup">

                <RadioButton x:Name="LightRadio"
                             Content="Açık (Light)"
                             Value="1"
                             Style="{StaticResource SettingsRadioStyle}"
                             CheckedChanged="OnThemeRadioCheckedChanged" />

                <RadioButton x:Name="DarkRadio"
                             Content="Koyu (Dark)"
                             Value="2"
                             Style="{StaticResource SettingsRadioStyle}"
                             CheckedChanged="OnThemeRadioCheckedChanged" />

                <RadioButton x:Name="SystemRadio"
                             Content="Sistem ayarını kullan (Use system setting)"
                             Value="0"
                             Style="{StaticResource SettingsRadioStyle}"
                             CheckedChanged="OnThemeRadioCheckedChanged" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>